# MongoDB Atlas SRV Connection URI (Private - Do not commit actual credentials)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Target Database Name
DB_NAME=student_db

# Port Configuration (Render automatically assigns PORT in cloud production)
PORT=5000

# Allowed Frontend Origins for CORS Security
FRONTEND_ORIGIN=http://localhost:5173,https://student-management-system-dinesh.vercel.app

# Environment
NODE_ENV=development
